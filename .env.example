# Copy this file to .env and adjust. Never commit .env.

# HTTP server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Name reported in the X-Served-By header and /api/health (defaults to the machine hostname).
# Set to web-01 / web-02 on the application servers so load-balancer distribution is visible.
SERVER_NAME=

# Express "trust proxy" setting. "loopback" trusts the local Nginx reverse proxy.
# On Web01/Web02 behind Lb01 use e.g. "loopback, <LB01_PRIVATE_IP>".
TRUST_PROXY=loopback

# openFDA (https://open.fda.gov/apis/authentication/)
# The API works without a key (240 requests/min, 1,000/day per IP).
# A free key raises the daily limit to 120,000. It is only used server-side.
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_TIMEOUT_MS=8000

# In-memory response cache
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=500
